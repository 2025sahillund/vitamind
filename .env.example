# ==============================================================================
# VitaMind Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Qdrant Vector Database
# Leave blank to run in local on-disk mode (./data/qdrant_local)
QDRANT_URL=https://your-cluster-id.region.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=vitamind_memories

# Embedding Model Configuration
# Options: "fastembed" (local zero-cost embedding) or "openai"
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Lyzr Agent Studio
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_lyzr_agent_id_here
LYZR_STUDIO_URL=https://agent-prod.studio.lyzr.ai/v3

# Omi Webhook Integration
# Secret token for authenticating inbound webhook requests (optional but recommended)
OMI_WEBHOOK_SECRET=your_optional_webhook_secret_here

# LLM Fallback / Direct Provider (if using direct model calls alongside Lyzr)
OPENAI_API_KEY=your_optional_openai_api_key_here
